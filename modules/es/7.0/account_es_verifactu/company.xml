<tryton>
    <data>

        <record model="ir.ui.view" id="company_form_view">
            <field name="model">company.company</field>
            <field name="inherit" ref="company.company_view_form"/>
            <field name="name">company_form</field>
        </record>
        <record model="ir.model.field.access" id="access_company_es_verifactu_private_key">
            <field name="field" search="[('model.model', '=', 'company.company'), ('name', '=', 'es_verifactu_private_key')]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
        </record>
        <record model="ir.model.field.access" id="access_company_es_verifactu_private_key_account">
            <field name="field" search="[('model.model', '=', 'company.company'), ('name', '=', 'es_verifactu_private_key')]"/>
            <field name="group" ref="account.group_account_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
        </record>

        <record model="ir.model.field.access" id="access_company_es_verifactu_certificate">
            <field name="field" search="[('model.model', '=', 'company.company'), ('name', '=', 'es_verifactu_certificate')]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
        </record>
        <record model="ir.model.field.access" id="access_company_es_verifactu_certificate_account">
            <field name="field" search="[('model.model', '=', 'company.company'), ('name', '=', 'es_verifactu_certificate')]"/>
            <field name="group" ref="account.group_account_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
        </record>

        <record model="ir.ui.view" id="load_credential_verifactu_start_view">
            <field name="model">company.load_credential.verifactu.start</field>
            <field name="type">form</field>
            <field name="name">load_credential_start</field>
        </record>
        <record model="ir.action.wizard" id="act_load_credential_verifactu">
            <field name="name">Load Verifactu Credentials</field>
            <field name="wiz_name">company.load_credential.verifactu</field>
        </record>

        <record model="ir.model.button" id="company_load_credential_verifactu_button">
            <field name="name">load_credential_verifactu</field>
            <field name="string">Load Verifactu Credentials</field>
            <field name="model" search="[('model', '=', 'company.company')]"/>
        </record>
        <record model="ir.model.button-res.group" id="company_load_credential_verifactu_button_group_account_admin">
            <field name="button" ref="company_load_credential_verifactu_button"/>
            <field name="group" ref="account.group_account_admin"/>
        </record>
    </data>
</tryton>
