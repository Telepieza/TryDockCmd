msgctxt "model:ir.message,text:msg_es_verifactu_invoice_delete_sent"
msgid ""
"You cannot delete Verifactu invoice \"%(invoice)s\" because it has already "
"been sent."
msgstr ""
"No podeu eliminar la factura verifactu \"%(invoice)s\" perquè ja s'ha "
"enviat."

msgctxt "model:ir.message,text:msg_es_verifactu_invoice_unique"
msgid "Only one Verifactu invoice can be created for each invoice."
msgstr "Només es pot crear una factura Verifactu per a cada factura"

msgctxt "model:ir.message,text:msg_es_verifactu_no_key_cert"
msgid ""
"In order to send Verifactu invoice a private key and a certificate must be "
"set for company \"%(company)s\"."
msgstr ""
"Per enviar els registres de facturació de verifactu s'ha de d'establir una "
"clau privada i un certificat per l'empresa \"%(company)s\"."

msgctxt "model:ir.message,text:msg_es_verifactu_posted_invoices"
msgid ""
"You can not change the Verifactu setting for period \"%(period)s\" because "
"there are already posted invoices."
msgstr ""
"No podeu canviar la configuració de verifactu pel període \"%(period)s\" "
"perquè ja hi ha factures comptabilitzades."

